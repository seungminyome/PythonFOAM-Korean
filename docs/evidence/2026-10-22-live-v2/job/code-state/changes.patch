+            harness = V2Harness({"LLM_MODE": "describe", "LLM_ENDPOINT": endpoint, "LLM_ASYNC": "1",
+                                 "LLM_IMAGE_XRANGE": "-0.5,0.5"})
+            try:
+                result = harness.run(sleep_after=5, sleep_s=0.3)
+                walls = dict(harness.walls)
