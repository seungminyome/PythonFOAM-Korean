+    def test_observe_and_four_step_sequences_are_refused_without_stopping_the_solver(self):
+        for environment, message in (({"LLM_MODE": "observe"}, "LLM_IMAGE_STYLE=v2"),
+                                     ({"LLM_MODE": "sequence", "LLM_SEQUENCE_STEPS": "2,4,6,8"},
