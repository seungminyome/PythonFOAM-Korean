FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object controlDict;
}
application pimpleFoam;
startFrom startTime;
startTime 0.1;
stopAt endTime;
endTime 0.14;
deltaT 2e-5;
writeControl timeStep;
writeInterval 10;
purgeWrite 0;
writeFormat ascii;
writePrecision 12;
writeCompression off;
timeFormat general;
timePrecision 10;
runTimeModifiable false;
adjustTimeStep no;
maxCo 0.5;
maxDeltaT 5e-6;
podSvdInterval 10;
functions {}
libs ("libincompressibleTurbulenceModels.so");
